<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_due_only"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="4.12.0">
  <bpmn:process id="simple_user_task_process_with_dueDate"
                name="Simple User Task Process With Due Date"
                isExecutable="true"
                camunda:historyTimeToLive="P180D">
    <bpmn:extensionElements>
      <camunda:properties>
        <camunda:property name="kadai.domain" value="DOMAIN_A" />
      </camunda:properties>
    </bpmn:extensionElements>

    <bpmn:startEvent id="StartEvent_due_only" name="Request Received">
      <bpmn:outgoing>Flow_start_to_task</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_start_to_task"
                       sourceRef="StartEvent_due_only"
                       targetRef="Task_due_only" />

    <bpmn:userTask id="Task_due_only"
                   name="Task With Due Date Only"
                   camunda:dueDate="2030-06-26T09:54:00">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="kadai.classification-key" value="L1050" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_task</bpmn:incoming>
      <bpmn:outgoing>Flow_task_to_end</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_task_to_end"
                       sourceRef="Task_due_only"
                       targetRef="EndEvent_due_only" />

    <bpmn:endEvent id="EndEvent_due_only" name="Request Processed">
      <bpmn:incoming>Flow_task_to_end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_due_only">
    <bpmndi:BPMNPlane id="BPMNPlane_due_only"
                      bpmnElement="simple_user_task_process_with_dueDate">
      <bpmndi:BPMNShape id="StartEvent_due_only_di" bpmnElement="StartEvent_due_only">
        <dc:Bounds x="173" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_due_only_di" bpmnElement="Task_due_only">
        <dc:Bounds x="248" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_due_only_di" bpmnElement="EndEvent_due_only">
        <dc:Bounds x="389" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_start_to_task_di" bpmnElement="Flow_start_to_task">
        <di:waypoint x="209" y="120" />
        <di:waypoint x="248" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_task_to_end_di" bpmnElement="Flow_task_to_end">
        <di:waypoint x="348" y="120" />
        <di:waypoint x="389" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
